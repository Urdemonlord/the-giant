; Engine configuration file.
; THE GIANT - Godot 4.3+ project
; It's best edited using the editor UI and not directly.

config_version=5

[application]

config/name="THE GIANT"
config/description="First-person psychological horror. Jaga pos jaga di Taman Nasional Malayunesia. Jangan biarkan mereka kembali."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation="landscape"

